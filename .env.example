# Database Configuration (SQLite zero-setup default)
DATABASE_URL="file:./dev.db"

# PostgreSQL production example (optional)
# DATABASE_URL="postgresql://username:password@localhost:5432/ctfforgedb?schema=public"

# Authentication Security (JWT Secret, minimum 32 characters)
JWT_SECRET="super-secret-random-jwt-key-for-ctfforge-ethical-hacking-2026"

# ==============================================================================
# AI TUTOR CONFIGURATION (TEMA 20: FEATURE F2)
# ==============================================================================

# Option 1: Local LLM via Ollama (Recommended for Offline/Lab Demo)
USE_OLLAMA="false"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Option 2: Google Gemini Cloud API (Optional Backup)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# Note: Jika USE_OLLAMA="false" dan GEMINI_API_KEY tidak diisi,
# platform secara otomatis mengaktifkan "Embedded Socratic Engine" bawaan
# yang 100% offline, bebas halusinasi, dan deterministik anti-kebocoran flag.
